# Anthropic-compatible config.
# ANTHROPIC_API_KEY=sk-ant-your-api-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# MODEL=claude-sonnet-4-6

# OpenAI-compatible config.
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o

# Generic aliases are also supported for compatible gateways.
# APIKEY=sk-your-api-key
# API=https://your-compatible-host/v1
# EVOSHELL_API_KEY=sk-your-api-key
# EVOSHELL_API_BASE=https://your-compatible-host/v1

# Skill evolution (enabled by default).
# EVOSHELL_AUTO_SKILL_EVOLUTION=1
# EVOSHELL_AUTO_SKILL_TARGET=project
